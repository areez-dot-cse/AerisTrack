# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Postgres connection strings (dev and test databases)
DATABASE_URL=postgres://localhost:5432/tna_tracker
DATABASE_URL_TEST=postgres://localhost:5432/tna_tracker_test

# At least 32 random characters. Required in production.
SESSION_SECRET=

# Groq (free tier) for Tamil speech-to-text and classification. Leave empty to use the keyword fallback.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Freezes "today" so the seeded demo always looks the same. Remove for real use.
DEMO_TODAY=2026-11-04
